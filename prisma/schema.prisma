// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("officer") // 'officer' or 'admin'
  createdAt    DateTime @default(now())
}

model Application {
  id              String   @id @default(uuid())
  citizenId       String?
  schemeId        String
  schemeTitle     String
  profileSnapshot String // JSON string
  status          String
  rejectionReason String?
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Report {
  id          String   @id @default(uuid())
  schemeCode  String
  description String
  status      String   @default("pending")
  receivedAt  DateTime @default(now())
}

model Feedback {
  id         String   @id @default(uuid())
  name       String
  email      String
  message    String
  receivedAt DateTime @default(now())
}

model ConsentRecord {
  id            String    @id @default(uuid())
  citizenId     String
  purpose       String
  noticeVersion String
  consentedAt   DateTime  @default(now())
  withdrawnAt   DateTime?
}

model GrievanceRecord {
  id          String   @id @default(uuid())
  email       String
  requestType String
  details     String
  status      String   @default("pending")
  receivedAt  DateTime @default(now())
}

model Scheme {
  id                String   @id @default(uuid())
  code              String   @unique
  title             String
  category          String
  level             String
  ministry          String
  rulesAST          String
  numericLimits     String
  fallbackSchemeIds String
  sourceCitation    String
  lastReviewedAt    DateTime
}

model RetentionLog {
  id                            String   @id @default(uuid())
  ranAt                         DateTime @default(now())
  applicationsDeleted           Int
  consentRecordsMarkedWithdrawn Int
}

model SchemeDraft {
  id               String    @id @default(uuid())
  targetSchemeCode String?
  payload          String    // JSON string containing full proposed Scheme shape
  status           String    @default("draft") // 'draft', 'published', 'discarded'
  createdBy        String
  createdAt        DateTime  @default(now())
  publishedBy      String?
  publishedAt      DateTime?
}
